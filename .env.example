# Supabase Configuration
# Copy this file to .env.local and fill in your values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_ANNUAL=price_your-annual-price-id

# Anthropic (classification, support copilot, and admin War Room analysis)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Optional War Room override. Defaults to the Opus model pinned in code.
# WAR_ROOM_MODEL=claude-opus-5

# Gmail-backed Olera Support Copilot
# Create an INTERNAL Google Cloud OAuth web client with Gmail API enabled.
GOOGLE_GMAIL_CLIENT_ID=your-google-oauth-client-id
GOOGLE_GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
# Exact callback registered on that OAuth client. Keep this on a stable domain.
GMAIL_OAUTH_REDIRECT_URI=https://olera.care/api/admin/support-email/oauth/callback
# Optional verified Gmail send-as alias. Defaults to the connected mailbox.
GMAIL_SUPPORT_FROM_ADDRESS=support@olera.care
# Separate high-entropy secrets for OAuth state signatures and AES-GCM token storage.
GMAIL_OAUTH_STATE_SECRET=replace-with-at-least-32-random-bytes
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-different-32-byte-secret
# Full Pub/Sub topic name used by Gmail users.watch.
GMAIL_PUBSUB_TOPIC=projects/your-google-project/topics/olera-support-gmail

# MapTiler (browse page map)
# Free tier: 100K tile loads/month — https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-api-key

# Deepgram (voice input fallback for Firefox/iOS Safari)
# $200 free credit for new accounts — https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-api-key

# Google Places API (review snippets on provider pages)
# Restricted to Places API (New) only — $5/1K requests
# Project: Olera Provider API (olera-provider-api)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Perplexity API (AI trust signal verification for non-CMS providers)
# ~$1 per 1,000 providers — https://docs.perplexity.ai/
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key

# Slack Integration (verification alerts and admin actions)
# Webhook URL: https://api.slack.com/apps/YOUR_APP/incoming-webhooks
# Signing Secret: https://api.slack.com/apps/YOUR_APP/general (Basic Information)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/WORKSPACE/CHANNEL/SECRET
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Smartlead (tier-2 cold MedJobs outreach — lib/smartlead.ts)
# API key: Smartlead → Settings → API. Until this is set, the outbound engine
# is a no-op (every call returns { ok: false }). Cold sending only; tier-1
# transactional mail stays on Resend/olera.care.
SMARTLEAD_API_KEY=your-smartlead-api-key
# Optional base-URL override; defaults to https://server.smartlead.ai/api/v1
# SMARTLEAD_BASE_URL=
# Auto-start campaigns on enrollment. Default OFF (campaigns are created PAUSED,
# a human starts them in Smartlead after warmup). Set to "true" to have the
# bridge call setCampaignStatus(START) the instant leads are enrolled.
# WARNING: a campaign can start before its mailbox pool is warm — starting cold
# before warmup torches domain reputation. Only flip this once mailboxes are warm.
# SMARTLEAD_AUTO_START_CAMPAIGNS=false
# Reply-webhook shared secret. MUST be identical to the SMARTLEAD_WEBHOOK_SECRET
# set on the Supabase edge function (it is baked into the ?secret= the function
# validates). Required for the app to AUTO-REGISTER the reply webhook when it
# provisions a campaign, and used by the Integrations "Connect Smartlead replies"
# reconcile. If unset, new campaigns are created without a webhook (replies won't
# flow) until it is set and the reconcile is run.
SMARTLEAD_WEBHOOK_SECRET=your-smartlead-webhook-secret
